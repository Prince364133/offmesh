# ==============================================================================
# OffMesh Production Environment Configuration
# Use this file as a template for Docker, GitHub Actions, and AWS ECS/AppRunner
# ==============================================================================

# Core Service Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16+)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://offmesh:offmesh_secret_password@postgres:5432/offmesh

# Cache & Message Broker (Redis 7+)
# Format: redis://<host>:<port>
REDIS_URL=redis://redis:6379

# Merkle Tree Reconciliation Parameters
MERKLE_BUCKET_MINUTES=5
MERKLE_SWEEP_INTERVAL_MINUTES=15

# Security & CORS
CORS_ORIGIN=*

# AWS Deployment Parameters (for future AWS ECS / AppRunner deployment)
# AWS_REGION=us-east-1
# AWS_CLUSTER_NAME=offmesh-cluster
# AWS_SERVICE_NAME=offmesh-backend-service
# AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com/offmesh-backend

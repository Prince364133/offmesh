---
// OffMesh Interactive Hop Simulator - Zero-infrastructure Delay-Tolerant Networking Demo
---
<div class="hop-simulator">
  <div class="sim-header">
    <div>
      <span class="caption-text">Live Interactive Demo</span>
      <h3 class="sim-title">Opportunistic Store & Forward Simulator</h3>
    </div>
    <button id="sim-trigger-btn" class="btn-primary btn-sm">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="22" y1="2" x2="11" y2="13"></line>
        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
      </svg>
      Send Test Packet
    </button>
  </div>

  <div class="sim-nodes-row">
    <!-- Alice -->
    <div class="sim-node" id="node-alice">
      <div class="node-avatar">A</div>
      <div class="node-meta">
        <span class="node-name">Alice</span>
        <span class="node-role">Sender (Offline)</span>
      </div>
      <div class="node-status-indicator" id="status-alice">Ready</div>
    </div>

    <!-- Hop link 1 -->
    <div class="sim-link" id="link-1">
      <span class="link-label">BLE 5.2</span>
      <div class="link-line"><div class="packet" id="packet-1"></div></div>
    </div>

    <!-- Relay Peer 1 -->
    <div class="sim-node" id="node-relay1">
      <div class="node-avatar">R1</div>
      <div class="node-meta">
        <span class="node-name">Relay 1</span>
        <span class="node-role">Peer (Bluetooth)</span>
      </div>
      <div class="node-status-indicator" id="status-relay1">Idle</div>
    </div>

    <!-- Hop link 2 -->
    <div class="sim-link" id="link-2">
      <span class="link-label">Wi-Fi Direct</span>
      <div class="link-line"><div class="packet" id="packet-2"></div></div>
    </div>

    <!-- Relay Peer 2 -->
    <div class="sim-node" id="node-relay2">
      <div class="node-avatar">R2</div>
      <div class="node-meta">
        <span class="node-name">Relay 2</span>
        <span class="node-role">Peer (Wi-Fi Direct)</span>
      </div>
      <div class="node-status-indicator" id="status-relay2">Idle</div>
    </div>

    <!-- Hop link 3 -->
    <div class="sim-link" id="link-3">
      <span class="link-label">Direct P2P</span>
      <div class="link-line"><div class="packet" id="packet-3"></div></div>
    </div>

    <!-- Bob -->
    <div class="sim-node" id="node-bob">
      <div class="node-avatar">B</div>
      <div class="node-meta">
        <span class="node-name">Bob</span>
        <span class="node-role">Recipient (Offline)</span>
      </div>
      <div class="node-status-indicator" id="status-bob">Awaiting</div>
    </div>
  </div>

  <div class="sim-terminal" id="sim-terminal">
    <div class="terminal-bar">
      <span class="terminal-title">OffMesh Cryptographic Packet Inspector</span>
      <span class="terminal-tag">BLAKE3 Merkle Verified</span>
    </div>
    <div class="terminal-body" id="terminal-body">
      <div class="term-line info">[OffMesh] System ready. Click "Send Test Packet" to simulate multi-hop peer relay without cell networks.</div>
    </div>
  </div>
</div>

<script>
  const btn = document.getElementById('sim-trigger-btn');
  const term = document.getElementById('terminal-body');
  const packet1 = document.getElementById('packet-1');
  const packet2 = document.getElementById('packet-2');
  const packet3 = document.getElementById('packet-3');

  const statusAlice = document.getElementById('status-alice');
  const statusRelay1 = document.getElementById('status-relay1');
  const statusRelay2 = document.getElementById('status-relay2');
  const statusBob = document.getElementById('status-bob');

  function log(type, msg) {
    if (!term) return;
    const line = document.createElement('div');
    line.className = `term-line ${type}`;
    line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
    term.appendChild(line);
    term.scrollTop = term.scrollHeight;
  }

  btn?.addEventListener('click', async () => {
    btn.setAttribute('disabled', 'true');
    term.innerHTML = '';
    
    // Reset statuses
    statusAlice.textContent = 'Encrypting';
    statusAlice.className = 'node-status-indicator active';
    statusRelay1.textContent = 'Idle';
    statusRelay1.className = 'node-status-indicator';
    statusRelay2.textContent = 'Idle';
    statusRelay2.className = 'node-status-indicator';
    statusBob.textContent = 'Awaiting';
    statusBob.className = 'node-status-indicator';

    log('info', 'Alice preparing message: "Meet at coordinates 37.7749, -122.4194"');
    await new Promise(r => setTimeout(r, 600));

    log('success', 'Double Ratchet generated: X25519 ephemeral key, ChaCha20-Poly1305 payload encrypted.');
    statusAlice.textContent = 'Broadcasting';
    
    // Hop 1
    packet1?.classList.add('moving');
    log('info', 'Hop 1/3: Transmitting via BLE 5.2 Advertisement to Relay 1 (Node a4f1)...');
    await new Promise(r => setTimeout(r, 900));
    packet1?.classList.remove('moving');

    statusRelay1.textContent = 'Storing Blob';
    statusRelay1.className = 'node-status-indicator active';
    log('info', 'Relay 1 verified envelope signature (Ed25519). Plaintext content unreadable to relay.');
    await new Promise(r => setTimeout(r, 700));

    // Hop 2
    statusRelay1.textContent = 'Forwarding';
    packet2?.classList.add('moving');
    log('info', 'Hop 2/3: Forwarding via Wi-Fi Direct socket to Relay 2 (Node c890)...');
    await new Promise(r => setTimeout(r, 900));
    packet2?.classList.remove('moving');

    statusRelay2.textContent = 'Storing Blob';
    statusRelay2.className = 'node-status-indicator active';
    log('info', 'Relay 2 accepted store-and-forward bundle. Route lookup matches Bob\'s public identity hash.');
    await new Promise(r => setTimeout(r, 700));

    // Hop 3
    statusRelay2.textContent = 'Forwarding';
    packet3?.classList.add('moving');
    log('info', 'Hop 3/3: Reaching target device Bob via direct peer pairing...');
    await new Promise(r => setTimeout(r, 900));
    packet3?.classList.remove('moving');

    statusBob.textContent = 'Decrypted!';
    statusBob.className = 'node-status-indicator success';
    statusAlice.textContent = 'Delivered ✓✓';
    statusAlice.className = 'node-status-indicator success';

    log('success', 'Bob decrypted plaintext with private ratchet key! Signed delivery receipt returned.');
    log('success', 'Complete mesh transfer finished across 3 hops with ZERO internet access!');

    btn.removeAttribute('disabled');
  });
</script>

<style>
  .hop-simulator {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
    margin: var(--space-12) 0;
  }

  .sim-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .sim-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .sim-nodes-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-8);
    overflow-x: auto;
    padding: var(--space-4) 0;
  }

  .sim-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100px;
    text-align: center;
  }

  .node-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-surface-subtle);
    border: 2px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-text-primary);
    margin-bottom: 8px;
    box-shadow: var(--shadow-subtle);
  }

  .node-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-text-primary);
    display: block;
  }

  .node-role {
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
    display: block;
  }

  .node-status-indicator {
    margin-top: 6px;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
  }

  .node-status-indicator.active {
    background: #FFF8E6;
    color: var(--color-status-pending);
    border-color: #FCD4BE;
  }

  .node-status-indicator.success {
    background: #EBF7EE;
    color: var(--color-status-success);
    border-color: #C4E9CE;
  }

  .sim-link {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 60px;
    padding: 0 4px;
  }

  .link-label {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--color-text-tertiary);
    margin-bottom: 4px;
  }

  .link-line {
    width: 100%;
    height: 3px;
    background: var(--color-border);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .packet {
    position: absolute;
    top: 0;
    left: -20px;
    width: 18px;
    height: 3px;
    background: var(--color-action-primary);
    border-radius: 2px;
  }

  .packet.moving {
    animation: movePacket 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes movePacket {
    0% { left: 0%; }
    100% { left: 100%; }
  }

  .sim-terminal {
    background: #111111;
    color: #F0F0F0;
    border-radius: var(--radius-md);
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: #1C1C1E;
    border-bottom: 1px solid #2C2C2E;
  }

  .terminal-title {
    font-weight: 600;
    font-size: 0.75rem;
    color: #A0A0A5;
  }

  .terminal-tag {
    font-size: 0.65rem;
    background: #2C2C2E;
    color: #34C759;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .terminal-body {
    padding: 12px 16px;
    min-height: 120px;
    max-height: 160px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .term-line.info { color: #D0D0D5; }
  .term-line.success { color: #34C759; font-weight: 600; }
</style>
